HYRAKU_JWT_SECRET=change-me-to-a-long-random-string
# Encrypts the whole database. Generate with: openssl rand -hex 32
# Keep a copy outside the VPS: without it the data cannot be recovered.
HYRAKU_DB_KEY=
HYRAKU_ADMIN_USER=hyraku
HYRAKU_ADMIN_PASSWORD=change-me
HYRAKU_HTTP_PORT=31080
HYRAKU_ADMIN_PORT=31081
HYRAKU_COOKIE_SECURE=true
CORS_ORIGINS=https://hyraku.com,https://www.hyraku.com,https://hyraku.in,https://www.hyraku.in,https://admin.hyraku.com,https://admin.hyraku.in,https://zyoim.aiccloud.online

# ── Hyraku beta ──────────────────────────────────────────────────────────────
# Copy to .env. Every value below has a working default, so the demo runs
# with no .env at all.

PORT=4000
DATABASE_URL="file:./hyraku.db"

# ── Channel ──────────────────────────────────────────────────────────────────
# simulator = built-in WhatsApp simulator, no Meta account needed (beta default)
# cloud     = live WhatsApp Cloud API (requires a verified WABA)
CHANNEL=simulator

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
# Only read when CHANNEL=cloud. Flipping this over is the entire go-live change.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=hyraku-verify
WHATSAPP_API_VERSION=v21.0

# ── Admin console ────────────────────────────────────────────────────────────
ADMIN_PASSWORD=hyraku

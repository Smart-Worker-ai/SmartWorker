# ── Hyraku ───────────────────────────────────────────────────────────────────
# Copy to .env for local work. On the servers this lives at
# /etc/hyraku/hyraku.env, root-owned and mode 0600, referenced by compose.
#
# Nothing here has a default. The process refuses to start with a value
# missing rather than run degraded.

NODE_ENV=production
PORT=4000
TZ=Asia/Kolkata
PUBLIC_URL=https://hyraku.in

# ── Database ─────────────────────────────────────────────────────────────────
# The application connects as a role with no DDL rights. Migrations run as
# hyraku_migrator, separately, from the deploy step.
DATABASE_URL=postgresql://hyraku_app:...@10.66.0.1:5432/hyraku
MIGRATE_DATABASE_URL=postgresql://hyraku_migrator:...@10.66.0.1:5432/hyraku

REDIS_URL=redis://:...@redis:6379

# ── Secrets ──────────────────────────────────────────────────────────────────
# openssl rand -base64 32
SESSION_SECRET=
# openssl rand -base64 32 — AES-256-GCM for Aadhaar and PVC images at rest.
# Rotating this without re-encrypting makes every stored document unreadable.
DOCUMENT_ENCRYPTION_KEY=

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
# Use a System User token. A user token expires in 60 days and takes the
# webhook down with it, silently.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ── SMS ──────────────────────────────────────────────────────────────────────
# Registration is phone-first, so workers whose number is not on WhatsApp are
# reached here. The sender ID and template need DLT registration, which takes
# days — start it early.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=

# ── Admin ────────────────────────────────────────────────────────────────────
# INTERIM. Removed when apps/admin authenticates against AdminUser.
ADMIN_PASSWORD=

# Read by the Prisma CLI (db:push, generate, studio). Committed on purpose so a
# fresh clone can build the demo database with no setup at all.
#
# The application runtime does NOT depend on this — packages/db/src/index.ts
# resolves the same file itself. Setting DATABASE_URL anywhere overrides both,
# which is the Postgres path.
DATABASE_URL="file:./hyraku.db"

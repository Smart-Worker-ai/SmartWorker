{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@hyraku/core": ["packages/core/src/index.ts"],
      "@hyraku/core/*": ["packages/core/src/*"],
      "@hyraku/db": ["packages/db/src/index.ts"],
      "@hyraku/whatsapp": ["packages/whatsapp/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "apps/api/src/**/*.ts"]
}

# ─────────────────────────────────────────────────────────────────────────────
# Admin Portal backend — environment template.
# Copy to .env (gitignored), fill in. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

ENV=production

# ── Admin credentials ───────────────────────────────────────────────────────
ADMIN_USERNAME=admin

# Generate the bcrypt hash once, then store ONLY the hash in this env:
#   python -c "from passlib.hash import bcrypt; import getpass; \
#              print(bcrypt.hash(getpass.getpass()))"
# Production REQUIRES the hash (not plaintext). The plaintext ADMIN_PASSWORD
# var is accepted in dev only.
ADMIN_PASSWORD_HASH=

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_HOURS=12

# ── Cross-service ───────────────────────────────────────────────────────────
CUSTOMER_BACKEND_URL=https://smart-workers-backend-production.up.railway.app/api/v1
CUSTOMER_BACKEND_ADMIN_SECRET=replace-me-with-a-32-char-random-string
WORKER_BACKEND_URL=https://workers-api.smartworkers.in/api

# ── CORS (frontend origins) ─────────────────────────────────────────────────
CORS_ORIGINS=https://admin.smartworkers.in

# ── Rate limit ──────────────────────────────────────────────────────────────
RATELIMIT_LOGIN=10/minute

<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) equivalent of backup_rules.xml.
    Excludes flutter_secure_storage from both cloud backup and device-to-device
    transfer so Keystore-backed secrets are never migrated to a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage"/>
    </device-transfer>
</data-extraction-rules>

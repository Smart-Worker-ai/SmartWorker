# ─────────────────────────────────────────────────────────────────────────────
# Top-level docker-compose env. Copy to `.env` (gitignored) and fill in.
#
# The per-service `env_file` files (`.env.node`, `.env.worker`, `.env.admin`)
# carry the service-specific config; this file only has things compose itself
# expands inside docker-compose.yml.
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_DB=smartworkers
POSTGRES_USER=smartworkers
POSTGRES_PASSWORD=replace-me-with-a-strong-password

# Optional: image registry prefix if you push to ghcr.io / dockerhub.
# IMAGE_REGISTRY=ghcr.io/your-org/

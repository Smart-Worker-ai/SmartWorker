# ============================================
# SMS Gateway — Environment Configuration
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit the .env file to version control.

# --- Application ---
NODE_ENV=development
PORT=3100
API_BASE_URL=http://localhost:3100

# --- HMAC Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
HMAC_SECRET=your-hmac-secret-here-change-in-production

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sms_gateway
DB_USER=sms_gateway_user
DB_PASSWORD=change-this-password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# --- OTP Configuration ---
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_PHONE_PER_DAY=5
OTP_MAX_PER_IP_PER_DAY=10
OTP_PEPPER=your-otp-pepper-change-in-production

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Provider: Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Provider: Plivo ---
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=

# --- Provider: MSG91 ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=

# --- Provider: TextLocal ---
TEXTLOCAL_API_KEY=
TEXTLOCAL_SENDER=

# --- Provider: Fast2SMS ---
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=

# --- Webhook ---
WEBHOOK_VERIFY_SIGNATURES=true

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- Metrics ---
METRICS_ENABLED=true
METRICS_PORT=9090

# --- Country Allow List (comma-separated ISO 3166-1 alpha-2) ---
ALLOWED_COUNTRIES=IN,US,GB,CA,AU

# --- Circuit Breaker ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
CIRCUIT_BREAKER_HALF_OPEN_MAX=3

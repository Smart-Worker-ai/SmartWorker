{
  "name": "sms-gateway",
  "version": "1.0.0",
  "description": "Production-grade SMS Gateway — provider-agnostic, queue-driven, multi-route OTP & messaging system",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/workers/index.ts",
    "dev:scheduler": "ts-node-dev --respawn --transpile-only src/workers/scheduler.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers/index.js",
    "start:scheduler": "node dist/workers/scheduler.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "ts-node src/scripts/migrate.ts",
    "db:seed": "ts-node src/scripts/seed.ts",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "dependencies": {
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.4.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "knex": "^3.1.0",
    "bullmq": "^5.12.0",
    "bcryptjs": "^2.4.3",
    "uuid": "^10.0.0",
    "libphonenumber-js": "^1.11.11",
    "winston": "^3.14.2",
    "prom-client": "^15.1.3",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "crypto-js": "^4.2.0",
    "http-errors": "^2.0.0",
    "express-async-errors": "^3.1.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "@types/node": "^22.7.4",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^10.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/http-errors": "^2.0.4",
    "@types/morgan": "^1.9.9",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.13",
    "eslint": "^9.11.1",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

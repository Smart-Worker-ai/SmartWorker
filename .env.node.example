# node_backend env (HAYAKU customer-facing API).
# Match these keys against your Node.js backend's config — names below mirror
# what the Python backends are configured to call.

NODE_ENV=production
PORT=3000

DATABASE_URL=postgres://smartworkers:CHANGE_ME@postgres:5432/smartworkers

# REQUIRED in production, each >= 32 chars (boot is refused otherwise — see
# src/config/env.js). Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ENCRYPTION_KEY=
# Must match worker_backend ADMIN_SECRET and admin_backend CUSTOMER_BACKEND_ADMIN_SECRET.
ADMIN_SECRET=CHANGE_ME_32_CHARS_MIN

# Browser origin(s) of the customer website (node_backend = customer API).
# Add app.crewzo.in here too if you host the SPA on a subdomain instead of root.
CORS_ORIGIN=https://crewzo.in,https://www.crewzo.in

# Firebase project ID — node verifies the customer phone token's `aud` against it
# (local RS256 verification; no service-account JSON needed).
FIREBASE_PROJECT_ID=

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=HAYAKU <noreply@crewzo.in>

# Optional SMS providers (in priority order)
CUSTOM_SMS_GATEWAY_URL=
CUSTOM_SMS_GATEWAY_SECRET=
FAST2SMS_API_KEY=

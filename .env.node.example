# node_backend env (Smart Workers customer-facing API).
# Match these keys against your Node.js backend's config — names below mirror
# what the Python backends are configured to call.

NODE_ENV=production
PORT=3000

DATABASE_URL=postgres://smartworkers:CHANGE_ME@postgres:5432/smartworkers

JWT_SECRET=
ENCRYPTION_KEY=
ADMIN_SECRET=CHANGE_ME_32_CHARS_MIN

CORS_ORIGIN=https://workers.smartworkers.in,https://admin.smartworkers.in

# Firebase Admin SDK for /auth/verify-firebase-phone — paste the entire JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=Smart Workers <noreply@smartworkers.in>

# Optional SMS providers (in priority order)
CUSTOM_SMS_GATEWAY_URL=
CUSTOM_SMS_GATEWAY_SECRET=
FAST2SMS_API_KEY=

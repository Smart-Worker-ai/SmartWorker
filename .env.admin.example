# admin_backend env (Admin Portal FastAPI). Copy to .env.admin.

ENV=production

ADMIN_USERNAME=admin

# Generate once:
#   docker compose run --rm admin_backend python -c \
#     "from passlib.hash import bcrypt; import getpass; print(bcrypt.hash(getpass.getpass()))"
ADMIN_PASSWORD_HASH=

# Random 48+ char URL-safe string. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_HOURS=12

CUSTOMER_BACKEND_URL=http://node_backend:3000/api/v1
CUSTOMER_BACKEND_ADMIN_SECRET=CHANGE_ME_32_CHARS_MIN
WORKER_BACKEND_URL=http://worker_backend:8000/api

CORS_ORIGINS=https://admin.crewzo.in

RATELIMIT_LOGIN=10/minute

UVICORN_WORKERS=2

{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://workers-api.crewzo.in/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://workers-api.crewzo.in/uploads/:path*"
    },
    {
      "source": "/((?!api/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}

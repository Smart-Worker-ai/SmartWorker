# ─────────────────────────────────────────────────────────────────────────────
# Worker Registration backend — environment template.
# Copy to .env (gitignored) and fill in. NEVER commit real values.
# `python-dotenv` will load this if you run uvicorn locally; in production
# inject these via the orchestrator (Docker / Railway / fly secrets).
# ─────────────────────────────────────────────────────────────────────────────

# Required in production. Missing values cause the server to refuse to boot.
ENV=production

# CORS — explicit list, comma-separated. NO wildcards in production.
CORS_ORIGINS=https://workers.smartworkers.in,https://admin.smartworkers.in

# Cross-service auth (must match every other backend that calls us).
ADMIN_SECRET=replace-me-with-a-32-char-random-string

# Customer-facing Node.js backend (Railway).
CUSTOMER_BACKEND_URL=https://smart-workers-backend-production.up.railway.app/api/v1

# This service's own public URL (used to build absolute photo URLs).
SELF_BASE_URL=https://workers-api.smartworkers.in

# Database (Postgres). Required in prod.
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/smartworkers

# Object storage (Cloudflare R2 / AWS S3 / MinIO).
S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=smartworkers-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# Optional: public CDN base URL if the bucket has a public custom domain.
# Leave blank to use short-lived presigned URLs instead.
S3_PUBLIC_URL_BASE=

# SMTP for OTP + notifications. Resend / Brevo / Gmail.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=Smart Workers <noreply@smartworkers.in>

# Session token TTL — 24 h matches the customer flow.
SESSION_TTL_HOURS=24

# Upload caps (megabytes).
MAX_DOC_SIZE_MB=5
MAX_PHOTO_SIZE_MB=2

# Rate limits (slowapi syntax).
RATELIMIT_REGISTRATION=3/hour
RATELIMIT_OTP_REQUEST=5/hour
RATELIMIT_OTP_VERIFY=10/hour

# worker_backend env (Worker Registration FastAPI). Copy to .env.worker.

ENV=production

DATABASE_URL=postgresql+asyncpg://smartworkers:CHANGE_ME@postgres:5432/smartworkers

# Cross-service. Must match ADMIN_SECRET on admin_backend.
ADMIN_SECRET=CHANGE_ME_32_CHARS_MIN

CUSTOMER_BACKEND_URL=http://node_backend:3000/api/v1
SELF_BASE_URL=https://workers-api.smartworkers.in

CORS_ORIGINS=https://workers.smartworkers.in,https://admin.smartworkers.in

# Object storage (Cloudflare R2 or AWS S3)
S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=smartworkers-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# Leave empty for presigned URLs; set if R2 bucket has a public custom domain.
S3_PUBLIC_URL_BASE=

# SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=Smart Workers <noreply@smartworkers.in>

SESSION_TTL_HOURS=24
MAX_DOC_SIZE_MB=5
MAX_PHOTO_SIZE_MB=2

RATELIMIT_REGISTRATION=3/hour
RATELIMIT_OTP_REQUEST=5/hour
RATELIMIT_OTP_VERIFY=10/hour

UVICORN_WORKERS=2

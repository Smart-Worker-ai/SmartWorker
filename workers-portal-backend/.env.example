PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://username:password@host:5432/workers_portal
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
ENCRYPTION_KEY=32_character_long_secret_key_here
ADMIN_SECRET=replace_with_your_admin_secret

# SMTP Email Service (required for OTP and notifications)
# Works with Gmail, SendGrid, Mailgun, Zoho, or any SMTP provider.
# For Gmail: enable "App Passwords" in your Google Account security settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Crewzo <your-email@gmail.com>

# SMS Service — Fast2SMS (https://www.fast2sms.com)
# Sign up, go to Dev API → copy your API key
FAST2SMS_API_KEY=your-fast2sms-api-key
